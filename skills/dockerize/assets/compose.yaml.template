services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    env_file:
      - .env
    environment:
      # Add non-secret defaults here. Keep secrets in env_file or read-only binds.
      APP_ENV: development
    volumes:
      - results:/work/results
      # Bind secret files only when the app needs file paths at runtime.
      # - type: bind
      #   source: ./.env
      #   target: /run/secrets/app.env
      #   read_only: true
      # Bind very large source/input folders instead of copying them into the image.
      # - type: bind
      #   source: ./samples
      #   target: /work/samples
      #   read_only: true
    # Publish only user-facing ports. Side services should stay internal by default.
    # ports:
    #   - "127.0.0.1:8080:8080"

  # Example internal database. No host port is exposed by default.
  db:
    image: postgres:16
    environment:
      POSTGRES_DB: app
      POSTGRES_USER: app
      POSTGRES_PASSWORD: app
    volumes:
      - db-data:/var/lib/postgresql/data

  tools:
    build:
      context: .
      dockerfile: Dockerfile
    profiles: ["tools"]
    volumes:
      - results:/work/results
    command: ["bash"]

  # Example GPU service for ML projects. Enable only when needed.
  # train:
  #   build:
  #     context: .
  #     dockerfile: Dockerfile
  #   command: ["python", "train.py"]
  #   environment:
  #     HF_HOME: /cache/huggingface
  #     HF_TOKEN: ${HF_TOKEN:-}
  #   volumes:
  #     # Default for Hugging Face: a shared external volume whose literal
  #     # fallback is resolved from the main worktree while dockerizing.
  #     - hf-cache:/cache/huggingface
  #     - results:/work/results
  #   # Bind alternative for native Linux when host cache access or ownership
  #   # is required: replace the hf-cache item above with the long-syntax bind
  #   # below and run the service as the host's numeric UID/GID.
  #   # user: "${HOST_UID:?set HOST_UID}:${HOST_GID:?set HOST_GID}"
  #   #   - type: bind
  #   #     source: ${HF_CACHE_DIR:-${HOME}/.cache/huggingface}
  #   #     target: /cache/huggingface
  #   #     read_only: false
  #   deploy:
  #     resources:
  #       reservations:
  #         devices:
  #           - driver: nvidia
  #             count: all
  #             capabilities: [gpu]

volumes:
  db-data:
    name: ${DB_DATA_VOLUME_NAME:-${COMPOSE_PROJECT_NAME}_db-data}
  results:
    name: ${RESULTS_VOLUME_NAME:-${COMPOSE_PROJECT_NAME}_results}
  model-cache:
    name: ${MODEL_CACHE_VOLUME_NAME:-${COMPOSE_PROJECT_NAME}_model-cache}
  hf-cache:
    # Replace this literal fallback with the validated main-worktree Compose
    # project name. Do not use the current worktree's COMPOSE_PROJECT_NAME.
    name: ${HF_CACHE_VOLUME_NAME:-replace-with-main-project-name_hf-cache}
    external: true
